{
  "name": "vortiqlabs-agent",
  "displayName": "VortiqLabs Agent",
  "description": "AI coding agent for VortiqLabs",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vortiqlabs-agent.workspace",
        "title": "VortiqLabs: Show Workspace"
      },
      {
        "command": "vortiqlabs-agent.fileRead",
        "title": "VortiqLabs: Read File"
      },
      {
        "command": "vortiqlabs-agent.fileWrite",
        "title": "VortiqLabs: Write File"
      },
      {
        "command": "vortiqlabs-agent.fileEdit",
        "title": "VortiqLabs: Edit File"
      }
    ]
  },
  "scripts": {
    "mcp:dev": "npm run check-types && node esbuild.js && node dist/mcp.js",
    "mcp:start": "node dist/mcp.js",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run test:unit",
    "test:unit": "npm run compile-tests && node --test out/test/**/*.test.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6",
    "express": "5.2.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
